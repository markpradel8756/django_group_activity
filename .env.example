# Local classroom defaults. Generate your own secret as described in README.md.
DJANGO_SECRET_KEY=your_django_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
DJANGO_TIME_ZONE=Asia/Manila
# Set to True to require a Django login for the workspace.
DJANGO_REQUIRE_LOGIN=False
# Defaults to True with debug off. Set explicitly for HTTPS-only development.
# DJANGO_SECURE_COOKIES=True
# Optional. Use the real HTTPS origin if users sign in or submit forms through it.
DJANGO_CSRF_TRUSTED_ORIGINS=

TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Optional. Use the same secret in your textbee webhook subscription.
TEXTBEE_WEBHOOK_SECRET=
